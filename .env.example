# FleetWise Configuration Example
# Copy this file to .env to customize settings

# Application Port
PORT=3000

# Environment (development, test, production)
NODE_ENV=development

# SQLite Database File Path
DB_PATH=./data/fleetwise.db

# JWT Secrets (REQUIRED in production - generate with openssl rand -hex 32)
# Ensure JWT_SECRET, JWT_REFRESH_SECRET, and OTP_HMAC_SECRET are distinct 32+ character secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Proof of Delivery HMAC Secret (REQUIRED in production - generate with openssl rand -hex 32)
OTP_HMAC_SECRET=

# Routing Service (OSRM & Haversine fallback)
# Note: The public demo server (http://router.project-osrm.org) is for dev only. Use a self-hosted OSRM URL in production.
OSRM_URL=http://router.project-osrm.org
ROUTING_AVG_SPEED_KMH=40
ROUTING_TIMEOUT_MS=3000

# Customer Notifications
NOTIFICATIONS_ENABLED=false
# Set to 'console' for local development or 'smtp' for production
NOTIFICATION_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FleetWise <no-reply@fleetwise.local>

# Initial Admin Seeding (Must be set in .env with a strong password before first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated or * for all in development)
CORS_ORIGIN=*
