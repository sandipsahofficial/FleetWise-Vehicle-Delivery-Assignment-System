# FleetWise Configuration Example
# Copy this file to .env to customize settings

# Application Port
PORT=3000

# Environment (development, test, production)
NODE_ENV=development

# SQLite Database File Path
DB_PATH=./data/fleetwise.db

# JWT Secrets (REQUIRED in production - generate strong random strings)
JWT_SECRET=supersecret_fleetwise_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=supersecret_fleetwise_jwt_refresh_token_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Proof of Delivery HMAC Secret (REQUIRED in production - generate strong random string)
OTP_HMAC_SECRET=supersecret_fleetwise_otp_hmac_secret_key_change_in_production

# Initial Admin Seeding (Optional on startup; creates initial admin if set and table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123!

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated or * for all in development)
CORS_ORIGIN=*
